diff --git a/drivers/gpu/drm/xe/xe_bo.c b/drivers/gpu/drm/xe/xe_bo.c
index 82f3215..48da91a 100644
--- a/drivers/gpu/drm/xe/xe_bo.c
+++ b/drivers/gpu/drm/xe/xe_bo.c
@@ -7,6 +7,7 @@
 
 #include <linux/dma-buf.h>
 #include <linux/nospec.h>
+#include <linux/swap.h>
 
 #include <drm/drm_drv.h>
 #include <drm/drm_dumb_buffers.h>
@@ -1414,6 +1415,48 @@ xe_bo_eviction_valuable(struct ttm_buffer_object *bo, const struct ttm_place *pl
 	return true;
 }
 
+/*
+ * Whether backing up @bo would most likely be undone right away: it is bound in
+ * a VM (only bound BOs are restored by that VM's next exec, see
+ * xe_vm_validate_rebind()), and a submission used it within
+ * xe.shrink_active_ms: for a VM-private BO its VM executed, for a shared BO an
+ * exec locked it (lru_refresh_jiffies). LR VMs don't restore on exec (their
+ * rebind worker does), and nothing is protected while system
+ * suspend/hibernation is prepared.
+ *
+ * Only kswapd honours this, and only for BOs with no unsignaled fences.
+ * Every other reclaimer (direct reclaim, drop_caches, memory.reclaim) runs
+ * with no_wait_gpu and skips busy BOs in ttm_bo_shrink_suitable(), so a busy
+ * BO must stay available to kswapd, which waits for it; an idle one stays
+ * available to them. Refusing GPU TT pages everywhere could get a bystander
+ * OOM-killed, as they don't count in RSS. Caller holds the BO resv.
+ */
+static bool xe_bo_shrink_recently_used(struct xe_bo *bo)
+{
+	unsigned int window_ms = READ_ONCE(xe_modparam.shrink_active_ms);
+	unsigned long last;
+
+	if (!window_ms || !current_is_kswapd() ||
+	    READ_ONCE(xe_bo_device(bo)->pm_shrink_all))
+		return false;
+
+	if (list_empty(&bo->ttm.base.gpuva.list))
+		return false;
+
+	if (bo->vm) {
+		if (xe_vm_in_lr_mode(bo->vm))
+			return false;
+		last = READ_ONCE(bo->vm->last_exec_jiffies);
+	} else {
+		last = READ_ONCE(bo->lru_refresh_jiffies);
+	}
+
+	if (!last || !time_before(jiffies, last + msecs_to_jiffies(window_ms)))
+		return false;
+
+	return dma_resv_test_signaled(bo->ttm.base.resv, DMA_RESV_USAGE_BOOKKEEP);
+}
+
 /**
  * xe_bo_shrink() - Try to shrink an xe bo.
  * @ctx: The struct ttm_operation_ctx used for shrinking.
@@ -1430,28 +1473,10 @@ xe_bo_eviction_valuable(struct ttm_buffer_object *bo, const struct ttm_place *pl
  * is updated.
  *
  * Return: The number of pages shrunken or purged, or negative error
- * code on failure.
+ * code on failure. -EBUSY or -EAGAIN (in active use, see
+ * xe_bo_shrink_recently_used()) with @scanned unchanged mean the bo was
+ * skipped.
  */
-/*
- * Whether @bo was used by a submission very recently: for a VM-private BO, its
- * VM executed; for a shared BO, an exec locked it (lru_refresh_jiffies). An
- * exec restores every evicted BO bound in its VM before running, so backing up
- * such a BO only makes the next frame swap it straight back in.
- */
-static bool xe_bo_shrink_recently_used(struct xe_bo *bo)
-{
-	unsigned int window_ms = READ_ONCE(xe_modparam.shrink_active_ms);
-	unsigned long last;
-
-	if (!window_ms)
-		return false;
-
-	last = bo->vm ? READ_ONCE(bo->vm->last_exec_jiffies) :
-		READ_ONCE(bo->lru_refresh_jiffies);
-
-	return last && time_before(jiffies, last + msecs_to_jiffies(window_ms));
-}
-
 long xe_bo_shrink(struct ttm_operation_ctx *ctx, struct ttm_buffer_object *bo,
 		  const struct xe_bo_shrink_flags flags,
 		  unsigned long *scanned)
@@ -1476,11 +1501,11 @@ long xe_bo_shrink(struct ttm_operation_ctx *ctx, struct ttm_buffer_object *bo,
 
 	/*
 	 * Purgeable (DONTNEED) BOs may go regardless. Others in active use are
-	 * skipped before being accounted as scanned, which the shrinker walk
-	 * treats as "try the next BO".
+	 * skipped with -EAGAIN before being accounted as scanned, and the
+	 * shrinker walk moves on to the next BO.
 	 */
 	if (!xe_tt->purgeable && xe_bo_shrink_recently_used(xe_bo)) {
-		lret = -EBUSY;
+		lret = -EAGAIN;
 		goto out_unref;
 	}
 
diff --git a/drivers/gpu/drm/xe/xe_device_types.h b/drivers/gpu/drm/xe/xe_device_types.h
index 683d84f..abbbdbf 100644
--- a/drivers/gpu/drm/xe/xe_device_types.h
+++ b/drivers/gpu/drm/xe/xe_device_types.h
@@ -453,6 +453,11 @@ struct xe_device {
 
 	/** @pm_notifier: Our PM notifier to perform actions in response to various PM events. */
 	struct notifier_block pm_notifier;
+	/**
+	 * @pm_shrink_all: system suspend/hibernation is being prepared; the
+	 * shrinker must not leave actively used BOs alone.
+	 */
+	bool pm_shrink_all;
 	/** @pm_block: Completion to block validating tasks on suspend / hibernate prepare */
 	struct completion pm_block;
 	/** @rebind_resume_list: List of wq items to kick on resume. */
diff --git a/drivers/gpu/drm/xe/xe_exec.c b/drivers/gpu/drm/xe/xe_exec.c
index 4acb572..d1e9964 100644
--- a/drivers/gpu/drm/xe/xe_exec.c
+++ b/drivers/gpu/drm/xe/xe_exec.c
@@ -171,8 +171,6 @@ int xe_exec_ioctl(struct drm_device *dev, void *data, struct drm_file *file)
 	}
 
 	vm = q->vm;
-	/* Lets the shrinker leave this VM's BOs alone while it is in use. */
-	WRITE_ONCE(vm->last_exec_jiffies, jiffies ?: 1);
 
 	for (num_syncs = 0; num_syncs < args->num_syncs; num_syncs++) {
 		err = xe_sync_entry_parse(xe, xef, &syncs[num_syncs],
@@ -358,6 +356,8 @@ retry:
 		xe_exec_queue_last_fence_set(q, vm, &job->drm.s_fence->finished);
 	xe_sched_job_push(job);
 	xe_vm_reactivate_rebind(vm);
+	/* Lets the shrinker leave this VM's bound BOs alone while it is in use. */
+	WRITE_ONCE(vm->last_exec_jiffies, jiffies ?: 1);
 
 	if (!err && !xe_vm_in_lr_mode(vm)) {
 		struct drm_gem_object *obj;
diff --git a/drivers/gpu/drm/xe/xe_module.c b/drivers/gpu/drm/xe/xe_module.c
index be2f696..8b10ef3 100644
--- a/drivers/gpu/drm/xe/xe_module.c
+++ b/drivers/gpu/drm/xe/xe_module.c
@@ -45,8 +45,9 @@ MODULE_PARM_DESC(flip_boost, "Briefly raise the GPU min frequency when a page fl
 		 "vblank because rendering has not finished [default=true]");
 
 module_param_named(shrink_active_ms, xe_modparam.shrink_active_ms, uint, 0600);
-MODULE_PARM_DESC(shrink_active_ms, "Don't let the shrinker back up BOs of a VM that submitted work, "
-		 "or shared BOs used by a submission, within this many ms; 0 disables [default=1000]");
+MODULE_PARM_DESC(shrink_active_ms, "Don't let kswapd back up BOs of a VM that submitted work, "
+		 "or shared BOs used by a submission, within this many ms, while they have no pending GPU work; "
+		 "0 disables [default=1000]");
 
 module_param_named(tlb_inval_coalesce, xe_modparam.tlb_inval_coalesce, bool, 0600);
 MODULE_PARM_DESC(tlb_inval_coalesce, "On GPUs without range TLB invalidation, merge full PPGTT "
diff --git a/drivers/gpu/drm/xe/xe_pm.c b/drivers/gpu/drm/xe/xe_pm.c
index a5289a9..8b314b7 100644
--- a/drivers/gpu/drm/xe/xe_pm.c
+++ b/drivers/gpu/drm/xe/xe_pm.c
@@ -440,6 +440,7 @@ static int xe_pm_notifier_callback(struct notifier_block *nb,
 	{
 		struct xe_validation_ctx ctx;
 
+		WRITE_ONCE(xe->pm_shrink_all, true);
 		reinit_completion(&xe->pm_block);
 		xe_pm_block_begin_signalling();
 		xe_pm_runtime_get(xe);
@@ -463,6 +464,7 @@ static int xe_pm_notifier_callback(struct notifier_block *nb,
 	}
 	case PM_POST_HIBERNATION:
 	case PM_POST_SUSPEND:
+		WRITE_ONCE(xe->pm_shrink_all, false);
 		complete_all(&xe->pm_block);
 		xe_pm_wake_rebind_workers(xe);
 		xe_bo_notifier_unprepare_all_pinned(xe);
diff --git a/drivers/gpu/drm/xe/xe_shrinker.c b/drivers/gpu/drm/xe/xe_shrinker.c
index deb4378..5869a1a 100644
--- a/drivers/gpu/drm/xe/xe_shrinker.c
+++ b/drivers/gpu/drm/xe/xe_shrinker.c
@@ -54,6 +54,14 @@ xe_shrinker_mod_pages(struct xe_shrinker *shrinker, long shrinkable, long purgea
 	write_unlock(&shrinker->lock);
 }
 
+/*
+ * How many BOs in a row a walk may skip in one memory type because they can't
+ * be shrunk right now (not purgeable in a purge pass, not eviction-valuable,
+ * idle-wait failed, in active use) before moving on to the next memory type.
+ * Bounds the walk cost when the LRU head is full of them.
+ */
+#define XE_SHRINK_MAX_BUSY_SKIPS 256
+
 static bool __xe_shrinker_runtime_pm_get(struct xe_shrinker *shrinker)
 {
 	struct xe_device *xe = shrinker->xe;
@@ -84,7 +92,7 @@ static int __xe_shrinker_walk(struct xe_shrinker *shrinker,
 			      unsigned long *freed)
 {
 	struct xe_device *xe = shrinker->xe;
-	unsigned int mem_type;
+	unsigned int mem_type, busy;
 	bool rpm = false;
 	int ret = 0;
 	s64 lret;
@@ -108,16 +116,38 @@ static int __xe_shrinker_walk(struct xe_shrinker *shrinker,
 			rpm = true;
 		}
 
+		busy = 0;
+
 		ttm_bo_lru_for_each_reserved_guarded(&curs, man, &arg, ttm_bo) {
 			if (!ttm_bo_shrink_suitable(ttm_bo, ctx))
 				continue;
 
+			unsigned long scanned_before = *scanned;
+
 			lret = xe_bo_shrink(ctx, ttm_bo, flags, scanned);
+			/*
+			 * xe_bo_shrink() accounts a BO as scanned only once it
+			 * starts shrinking it. -EBUSY or -EAGAIN (in active
+			 * use) before that means "skip this BO"; after it
+			 * (ttm_bo_shrink() maps backup and validate failures to
+			 * -EBUSY) the BO may already have been unbound, so stop
+			 * instead of repeating that.
+			 */
+			if ((lret == -EBUSY || lret == -EAGAIN) &&
+			    *scanned == scanned_before) {
+				if (*scanned >= to_scan)
+					goto out;
+				/* Give up on this memory type, not the others. */
+				if (++busy >= XE_SHRINK_MAX_BUSY_SKIPS)
+					break;
+				continue;
+			}
 			if (lret < 0) {
 				ret = lret;
 				goto out;
 			}
 
+			busy = 0;
 			*freed += lret;
 			if (*scanned >= to_scan)
 				goto out;

index 1025a2b..b3fc2c7 100644
--- a/drivers/gpu/drm/xe/xe_guc_pc.h
+++ b/drivers/gpu/drm/xe/xe_guc_pc.h
@@ -40,5 +40,6 @@ int xe_guc_pc_restore_stashed_freq(struct xe_guc_pc *pc);
 void xe_guc_pc_raise_unslice(struct xe_guc_pc *pc);
 void xe_guc_pc_apply_flush_freq_limit(struct xe_guc_pc *pc);
 void xe_guc_pc_remove_flush_freq_limit(struct xe_guc_pc *pc);
+void xe_guc_pc_boost(struct xe_guc_pc *pc);
 
 #endif /* _XE_GUC_PC_H_ */
diff --git a/drivers/gpu/drm/xe/xe_guc_pc_types.h b/drivers/gpu/drm/xe/xe_guc_pc_types.h
index 711bbcd..0c43caa 100644
--- a/drivers/gpu/drm/xe/xe_guc_pc_types.h
+++ b/drivers/gpu/drm/xe/xe_guc_pc_types.h
@@ -7,6 +7,7 @@
 #define _XE_GUC_PC_TYPES_H_
 
 #include <linux/mutex.h>
+#include <linux/workqueue_types.h>
 #include <linux/types.h>
 
 /**
@@ -35,6 +36,14 @@ struct xe_guc_pc {
 	bool freq_ready;
 	/** @power_profile: Base or power_saving profile */
 	u32 power_profile;
+	/** @boost_work: raises the min freq after a missed page flip */
+	struct work_struct boost_work;
+	/** @unboost_work: restores the min freq once flips stop missing */
+	struct delayed_work unboost_work;
+	/** @boosted: min freq is currently raised by @boost_work, under @freq_lock */
+	bool boosted;
+	/** @boost_saved_min: min freq in effect before boosting, under @freq_lock */
+	u32 boost_saved_min;
 };
 
 #endif	/* _XE_GUC_PC_TYPES_H_ */
diff --git a/drivers/gpu/drm/xe/xe_module.c b/drivers/gpu/drm/xe/xe_module.c
index 99347f2..335347c 100644
--- a/drivers/gpu/drm/xe/xe_module.c

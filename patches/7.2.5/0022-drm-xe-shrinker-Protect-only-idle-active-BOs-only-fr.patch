@@ -171,8 +171,6 @@ int xe_exec_ioctl(struct drm_device *dev, void *data, struct drm_file *file)
 	}
 
 	vm = q->vm;
-	/* Lets the shrinker leave this VM's BOs alone while it is in use. */
-	WRITE_ONCE(vm->last_exec_jiffies, jiffies ?: 1);
 
 	for (num_syncs = 0; num_syncs < args->num_syncs; num_syncs++) {
 		err = xe_sync_entry_parse(xe, xef, &syncs[num_syncs],
@@ -358,6 +356,8 @@ retry:
 		xe_exec_queue_last_fence_set(q, vm, &job->drm.s_fence->finished);

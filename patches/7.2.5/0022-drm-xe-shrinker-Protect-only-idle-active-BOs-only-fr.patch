 MODULE_PARM_DESC(tlb_inval_coalesce, "On GPUs without range TLB invalidation, merge full PPGTT "
diff --git a/drivers/gpu/drm/xe/xe_pm.c b/drivers/gpu/drm/xe/xe_pm.c
index 99562f6..a9cb9a6 100644
--- a/drivers/gpu/drm/xe/xe_pm.c
+++ b/drivers/gpu/drm/xe/xe_pm.c
@@ -440,6 +440,7 @@ static int xe_pm_notifier_callback(struct notifier_block *nb,
 	{
 		struct xe_validation_ctx ctx;
 
+		WRITE_ONCE(xe->pm_shrink_all, true);
 		reinit_completion(&xe->pm_block);
 		xe_pm_block_begin_signalling();
 		xe_pm_runtime_get(xe);
@@ -463,6 +464,7 @@ static int xe_pm_notifier_callback(struct notifier_block *nb,
 	}
 	case PM_POST_HIBERNATION:
 	case PM_POST_SUSPEND:

diff --git a/drivers/gpu/drm/xe/xe_bo.c b/drivers/gpu/drm/xe/xe_bo.c
index 2aadc8d..c5e3d69 100644
--- a/drivers/gpu/drm/xe/xe_bo.c
+++ b/drivers/gpu/drm/xe/xe_bo.c
@@ -7,6 +7,7 @@
 
 #include <linux/dma-buf.h>
 #include <linux/nospec.h>
+#include <linux/swap.h>
 
 #include <drm/drm_drv.h>
 #include <drm/drm_dumb_buffers.h>
@@ -1292,6 +1293,48 @@ xe_bo_eviction_valuable(struct ttm_buffer_object *bo, const struct ttm_place *pl
 	return true;
 }
 
+/*
+ * Whether backing up @bo would most likely be undone right away: it is bound in
+ * a VM (only bound BOs are restored by that VM's next exec, see
+ * xe_vm_validate_rebind()), and a submission used it within
+ * xe.shrink_active_ms: for a VM-private BO its VM executed, for a shared BO an
+ * exec locked it (lru_refresh_jiffies). LR VMs don't restore on exec (their
+ * rebind worker does), and nothing is protected while system
+ * suspend/hibernation is prepared.
+ *
+ * Only kswapd honours this, and only for BOs with no unsignaled fences.
+ * Every other reclaimer (direct reclaim, drop_caches, memory.reclaim) runs
+ * with no_wait_gpu and skips busy BOs in ttm_bo_shrink_suitable(), so a busy
+ * BO must stay available to kswapd, which waits for it; an idle one stays
+ * available to them. Refusing GPU TT pages everywhere could get a bystander
+ * OOM-killed, as they don't count in RSS. Caller holds the BO resv.
+ */
+static bool xe_bo_shrink_recently_used(struct xe_bo *bo)
+{
+	unsigned int window_ms = READ_ONCE(xe_modparam.shrink_active_ms);
+	unsigned long last;
+
+	if (!window_ms || !current_is_kswapd() ||
+	    READ_ONCE(xe_bo_device(bo)->pm_shrink_all))
+		return false;
+
+	if (list_empty(&bo->ttm.base.gpuva.list))
+		return false;
+
+	if (bo->vm) {
+		if (xe_vm_in_lr_mode(bo->vm))
+			return false;
+		last = READ_ONCE(bo->vm->last_exec_jiffies);
+	} else {
+		last = READ_ONCE(bo->lru_refresh_jiffies);
+	}
+
+	if (!last || !time_before(jiffies, last + msecs_to_jiffies(window_ms)))
+		return false;
+
+	return dma_resv_test_signaled(bo->ttm.base.resv, DMA_RESV_USAGE_BOOKKEEP);
+}
+
 /**
  * xe_bo_shrink() - Try to shrink an xe bo.
  * @ctx: The struct ttm_operation_ctx used for shrinking.
@@ -1308,28 +1351,10 @@ xe_bo_eviction_valuable(struct ttm_buffer_object *bo, const struct ttm_place *pl
  * is updated.
  *
  * Return: The number of pages shrunken or purged, or negative error
- * code on failure.
- */
-/*
- * Whether @bo was used by a submission very recently: for a VM-private BO, its
- * VM executed; for a shared BO, an exec locked it (lru_refresh_jiffies). An
- * exec restores every evicted BO bound in its VM before running, so backing up
- * such a BO only makes the next frame swap it straight back in.
+ * code on failure. -EBUSY or -EAGAIN (in active use, see
+ * xe_bo_shrink_recently_used()) with @scanned unchanged mean the bo was
+ * skipped.
  */
-static bool xe_bo_shrink_recently_used(struct xe_bo *bo)
-{
-	unsigned int window_ms = READ_ONCE(xe_modparam.shrink_active_ms);
-	unsigned long last;
-
-	if (!window_ms)
-		return false;
-
-	last = bo->vm ? READ_ONCE(bo->vm->last_exec_jiffies) :
-		READ_ONCE(bo->lru_refresh_jiffies);
-
-	return last && time_before(jiffies, last + msecs_to_jiffies(window_ms));
-}
-
 long xe_bo_shrink(struct ttm_operation_ctx *ctx, struct ttm_buffer_object *bo,
 		  const struct xe_bo_shrink_flags flags,
 		  unsigned long *scanned)
@@ -1354,11 +1379,11 @@ long xe_bo_shrink(struct ttm_operation_ctx *ctx, struct ttm_buffer_object *bo,
 
 	/*
 	 * Purgeable (DONTNEED) BOs may go regardless. Others in active use are
-	 * skipped before being accounted as scanned, which the shrinker walk
-	 * treats as "try the next BO".
+	 * skipped with -EAGAIN before being accounted as scanned, and the
+	 * shrinker walk moves on to the next BO.
 	 */
 	if (!xe_tt->purgeable && xe_bo_shrink_recently_used(xe_bo)) {
-		lret = -EBUSY;
+		lret = -EAGAIN;
 		goto out_unref;
 	}
 

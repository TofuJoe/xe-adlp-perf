diff --git a/drivers/gpu/drm/xe/xe_shrinker.c b/drivers/gpu/drm/xe/xe_shrinker.c
index b8aa942..915e0b4 100644
--- a/drivers/gpu/drm/xe/xe_shrinker.c
+++ b/drivers/gpu/drm/xe/xe_shrinker.c
@@ -55,9 +55,10 @@ xe_shrinker_mod_pages(struct xe_shrinker *shrinker, long shrinkable, long purgea
 }
 
 /*
- * How many BOs in a row a walk may skip because they can't be shrunk right now
- * (not purgeable in a purge pass, not eviction-valuable, idle-wait failed)
- * before giving up. Bounds the walk cost when the LRU head is full of them.
+ * How many BOs in a row a walk may skip in one memory type because they can't
+ * be shrunk right now (not purgeable in a purge pass, not eviction-valuable,
+ * idle-wait failed, in active use) before moving on to the next memory type.
+ * Bounds the walk cost when the LRU head is full of them.
  */
 #define XE_SHRINK_MAX_BUSY_SKIPS 256
 
@@ -73,7 +74,7 @@ static s64 __xe_shrinker_walk(struct xe_device *xe,
 			      unsigned long to_scan, unsigned long *scanned,
 			      bool *stop)
 {
-	unsigned int mem_type, busy = 0;
+	unsigned int mem_type, busy;
 	s64 freed = 0, lret;
 
 	for (mem_type = XE_PL_SYSTEM; mem_type <= XE_PL_TT; ++mem_type) {
@@ -88,6 +89,8 @@ static s64 __xe_shrinker_walk(struct xe_device *xe,
 		if (!man || !man->use_tt)
 			continue;
 
+		busy = 0;
+
 		ttm_bo_lru_for_each_reserved_guarded(&curs, man, &arg, ttm_bo) {
 			if (!ttm_bo_shrink_suitable(ttm_bo, ctx))
 				continue;
@@ -97,15 +100,18 @@ static s64 __xe_shrinker_walk(struct xe_device *xe,
 			lret = xe_bo_shrink(ctx, ttm_bo, flags, scanned);
 			/*
 			 * xe_bo_shrink() accounts a BO as scanned only once it
-			 * starts shrinking it. -EBUSY before that means "skip
-			 * this BO"; after it (ttm_bo_shrink() maps backup and
+			 * starts shrinking it. -EBUSY or -EAGAIN (in active
+			 * use) before that means "skip this BO"; after it (ttm_bo_shrink() maps backup and
 			 * validate failures to -EBUSY) the BO may already have
 			 * been unbound, so stop instead of repeating that.
 			 */
-			if (lret == -EBUSY && *scanned == scanned_before) {
-				if (++busy >= XE_SHRINK_MAX_BUSY_SKIPS ||
-				    *scanned >= to_scan)
+			if ((lret == -EBUSY || lret == -EAGAIN) &&
+			    *scanned == scanned_before) {
+				if (*scanned >= to_scan)
 					return freed;
+				/* Give up on this memory type, not the others. */
+				if (++busy >= XE_SHRINK_MAX_BUSY_SKIPS)
+					break;
 				continue;
 			}
 			if (lret < 0) {

From ed1565a2590eb4a1a46b50a4f8243f73d33d9f38 Mon Sep 17 00:00:00 2001
From: TofuJoe <darryl.hon@gmail.com>
Date: Mon, 14 Sep 2026 21:15:19 -0600
Subject: [PATCH 12/22] drm/xe/bo: Track a backing generation per BO

Add bo->backing_gen, a globally unique value renewed whenever a BO's pages,
resource or DMA mapping may change: creation, TT create/populate/unpopulate,
sg map/unmap, dma-buf map, move, move_notify, pinned DMA unmap and shrink.
Values come from one global counter and are never reused, so a user can
cache data derived from a BO's addresses and validate it with a compare.

Assisted-by: Claude:claude-opus-5
---
 drivers/gpu/drm/xe/xe_bo.c       | 51 ++++++++++++++++++++++++++++++++
 drivers/gpu/drm/xe/xe_bo.h       |  1 +
 drivers/gpu/drm/xe/xe_bo_types.h |  7 +++++
 3 files changed, 59 insertions(+)

diff --git a/drivers/gpu/drm/xe/xe_bo.c b/drivers/gpu/drm/xe/xe_bo.c
index 2d67aed..f8ab46b 100644
--- a/drivers/gpu/drm/xe/xe_bo.c
+++ b/drivers/gpu/drm/xe/xe_bo.c
@@ -365,8 +365,42 @@ struct xe_ttm_tt {
 	struct sg_table *sg;
 	/** @purgeable: Whether the content of the pages of @ttm is purgeable. */
 	bool purgeable;
+	/** @bo: the BO this TT belongs to, for backing_gen updates */
+	struct xe_bo *bo;
 };
 
+static atomic64_t xe_bo_backing_gen_counter = ATOMIC64_INIT(0);
+
+/*
+ * Mark that @bo's pages, resource or DMA addresses may have changed. Values
+ * come from one global counter, so they are never reused, not even by a later
+ * BO at the same address.
+ */
+static void xe_bo_backing_changed(struct xe_bo *bo)
+{
+	WRITE_ONCE(bo->backing_gen, atomic64_inc_return(&xe_bo_backing_gen_counter));
+}
+
+static void xe_tt_backing_changed(struct ttm_tt *tt)
+{
+	struct xe_ttm_tt *xe_tt = container_of(tt, struct xe_ttm_tt, ttm);
+
+	if (xe_tt->bo)
+		xe_bo_backing_changed(xe_tt->bo);
+}
+
+/**
+ * xe_bo_backing_gen() - Current backing generation of a BO
+ * @bo: The BO, pinned or locked so that its backing cannot change
+ *
+ * Return: a value that differs from any value previously returned for this or
+ * any other BO if the BO's backing store may have changed since.
+ */
+u64 xe_bo_backing_gen(struct xe_bo *bo)
+{
+	return READ_ONCE(bo->backing_gen);
+}
+
 static int xe_tt_map_sg(struct xe_device *xe, struct ttm_tt *tt)
 {
 	struct xe_ttm_tt *xe_tt = container_of(tt, struct xe_ttm_tt, ttm);
@@ -379,6 +413,7 @@ static int xe_tt_map_sg(struct xe_device *xe, struct ttm_tt *tt)
 	if (xe_tt->sg)
 		return 0;
 
+	xe_tt_backing_changed(tt);
 	ret = sg_alloc_table_from_pages_segment(&xe_tt->sgt, tt->pages,
 						num_pages, 0,
 						(u64)num_pages << PAGE_SHIFT,
@@ -404,6 +439,7 @@ static void xe_tt_unmap_sg(struct xe_device *xe, struct ttm_tt *tt)
 	struct xe_ttm_tt *xe_tt = container_of(tt, struct xe_ttm_tt, ttm);
 
 	if (xe_tt->sg) {
+		xe_tt_backing_changed(tt);
 		dma_unmap_sgtable(xe->drm.dev, xe_tt->sg,
 				  DMA_BIDIRECTIONAL, 0);
 		sg_free_table(xe_tt->sg);
@@ -471,6 +507,9 @@ static struct ttm_tt *xe_ttm_tt_create(struct ttm_buffer_object *ttm_bo,
 	if (!xe_tt)
 		return NULL;
 
+	xe_tt->bo = bo;
+	xe_bo_backing_changed(bo);
+
 	tt = &xe_tt->ttm;
 
 	extra_pages = 0;
@@ -549,6 +588,7 @@ static int xe_ttm_tt_populate(struct ttm_device *ttm_dev, struct ttm_tt *tt,
 	    !(tt->page_flags & TTM_TT_FLAG_EXTERNAL_MAPPABLE))
 		return 0;
 
+	xe_tt_backing_changed(tt);
 	if (ttm_tt_is_backed_up(tt) && !xe_tt->purgeable) {
 		err = ttm_tt_restore(ttm_dev, tt, ctx);
 	} else {
@@ -573,6 +613,7 @@ static void xe_ttm_tt_unpopulate(struct ttm_device *ttm_dev, struct ttm_tt *tt)
 	    !(tt->page_flags & TTM_TT_FLAG_EXTERNAL_MAPPABLE))
 		return;
 
+	xe_tt_backing_changed(tt);
 	xe_tt_unmap_sg(xe, tt);
 
 	ttm_pool_free(&ttm_dev->pool, tt);
@@ -743,6 +784,8 @@ static int xe_bo_move_dmabuf(struct ttm_buffer_object *ttm_bo,
 	xe_assert(xe, attach);
 	xe_assert(xe, ttm_bo->ttm);
 
+	xe_bo_backing_changed(ttm_to_xe_bo(ttm_bo));
+
 	if (device_unplugged && new_res->mem_type == XE_PL_SYSTEM &&
 	    ttm_bo->sg) {
 		dma_resv_wait_timeout(ttm_bo->base.resv, DMA_RESV_USAGE_BOOKKEEP,
@@ -799,6 +842,8 @@ static int xe_bo_move_notify(struct xe_bo *bo,
 	u32 old_mem_type = old_mem ? old_mem->mem_type : XE_PL_SYSTEM;
 	int ret;
 
+	xe_bo_backing_changed(bo);
+
 	/*
 	 * If this starts to call into many components, consider
 	 * using a notification chain here.
@@ -966,6 +1011,8 @@ static int xe_bo_move(struct ttm_buffer_object *ttm_bo, bool evict,
 				  ttm && ttm_tt_is_populated(ttm)) ? true : false;
 	int ret = 0;
 
+	xe_bo_backing_changed(bo);
+
 	/*
 	 * Purge only non-shared BOs explicitly marked DONTNEED by userspace.
 	 * The move_notify callback will handle invalidation asynchronously.
@@ -1284,6 +1331,8 @@ long xe_bo_shrink(struct ttm_operation_ctx *ctx, struct ttm_buffer_object *bo,
 	if (!xe_bo_is_xe_bo(bo) || !xe_bo_get_unless_zero(xe_bo))
 		return xe_bo_shrink_purge(ctx, bo, scanned);
 
+	xe_bo_backing_changed(xe_bo);
+
 	if (xe_tt->purgeable) {
 		if (bo->resource->mem_type != XE_PL_SYSTEM)
 			lret = xe_bo_move_notify(xe_bo, ctx);
@@ -1616,6 +1665,7 @@ int xe_bo_dma_unmap_pinned(struct xe_bo *bo)
 	struct ttm_buffer_object *ttm_bo = &bo->ttm;
 	struct ttm_tt *tt = ttm_bo->ttm;
 
+	xe_bo_backing_changed(bo);
 	if (tt) {
 		struct xe_ttm_tt *xe_tt = container_of(tt, typeof(*xe_tt), ttm);
 
@@ -2381,6 +2431,7 @@ struct xe_bo *xe_bo_init_locked(struct xe_device *xe, struct xe_bo *bo,
 	bo->purgeable.state = XE_MADV_PURGEABLE_WILLNEED;
 
 	drm_gem_private_object_init(&xe->drm, &bo->ttm.base, size);
+	xe_bo_backing_changed(bo);
 
 	if (resv) {
 		ctx.allow_res_evict = !(flags & XE_BO_FLAG_NO_RESV_EVICT);
diff --git a/drivers/gpu/drm/xe/xe_bo.h b/drivers/gpu/drm/xe/xe_bo.h
index 35055ee..964c016 100644
--- a/drivers/gpu/drm/xe/xe_bo.h
+++ b/drivers/gpu/drm/xe/xe_bo.h
@@ -443,6 +443,7 @@ int xe_bo_notifier_unprepare_pinned(struct xe_bo *bo);
 int xe_bo_restore_pinned(struct xe_bo *bo);
 
 int xe_bo_dma_unmap_pinned(struct xe_bo *bo);
+u64 xe_bo_backing_gen(struct xe_bo *bo);
 
 extern const struct ttm_device_funcs xe_ttm_funcs;
 extern const char *const xe_mem_type_to_name[];
diff --git a/drivers/gpu/drm/xe/xe_bo_types.h b/drivers/gpu/drm/xe/xe_bo_types.h
index e45f243..ff90eed 100644
--- a/drivers/gpu/drm/xe/xe_bo_types.h
+++ b/drivers/gpu/drm/xe/xe_bo_types.h
@@ -112,6 +112,13 @@ struct xe_bo {
 	 */
 	u64 min_align;
 
+	/**
+	 * @backing_gen: globally unique value, renewed whenever the backing
+	 * store, the resource or the DMA mapping of this BO may have changed.
+	 * Lets display reuse page tables built from the BO's addresses.
+	 */
+	u64 backing_gen;
+
 	/**
 	 * @purgeable: Purgeability state and accounting.
 	 *
-- 
2.55.0


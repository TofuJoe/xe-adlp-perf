From 1cdd501b23f7d94941628b233d778ffd31accfd1 Mon Sep 17 00:00:00 2001
From: TofuJoe <darryl.hon@gmail.com>
Date: Mon, 14 Sep 2026 16:25:17 -0700
Subject: [PATCH 07/22] drm/xe: Allocate the exec job before taking VM and
 dma-resv locks

xe_exec_ioctl() allocated the scheduler job only after locking the VM, the
dma-resv of the VM and every external BO, and xe->val.lock, and after
validating/rebinding. Under memory pressure the allocation can enter direct
reclaim with all of those held, stalling other processes that exec on the
same shared buffers (typically the compositor).

Create the job before the VM lock. On -EAGAIN retries drop it and create a
fresh one, since dependencies may already have been added.

Assisted-by: Claude:claude-opus-5
---
 drivers/gpu/drm/xe/xe_exec.c | 38 +++++++++++++++++++++++++-----------
 1 file changed, 27 insertions(+), 11 deletions(-)

diff --git a/drivers/gpu/drm/xe/xe_exec.c b/drivers/gpu/drm/xe/xe_exec.c
index d5293bc..70db369 100644
--- a/drivers/gpu/drm/xe/xe_exec.c
+++ b/drivers/gpu/drm/xe/xe_exec.c
@@ -122,7 +122,7 @@ int xe_exec_ioctl(struct drm_device *dev, void *data, struct drm_file *file)
 	struct drm_exec *exec = &vm_exec.exec;
 	u32 i, num_syncs, num_in_sync = 0, num_ufence = 0;
 	struct xe_validation_ctx ctx;
-	struct xe_sched_job *job;
+	struct xe_sched_job *job = NULL;
 	struct xe_vm *vm;
 	bool write_locked;
 	int err = 0;
@@ -213,6 +213,23 @@ int xe_exec_ioctl(struct drm_device *dev, void *data, struct drm_file *file)
 	}
 
 retry:
+	/*
+	 * Allocate the job before taking the VM lock, the dma-resv locks of the
+	 * VM and every external BO, and the device validation lock: under
+	 * memory pressure the allocation can enter direct reclaim, and doing
+	 * that with those locks held stalls every other exec touching the same
+	 * shared buffers (e.g. the compositor).
+	 */
+	if (args->num_batch_buffer && !job) {
+		job = xe_sched_job_create(q, xe_exec_queue_is_parallel(q) ?
+					  addresses : &args->address);
+		if (IS_ERR(job)) {
+			err = PTR_ERR(job);
+			job = NULL;
+			goto err_hw_exec_mode;
+		}
+	}
+
 	if (!xe_vm_in_lr_mode(vm) && xe_vm_userptr_check_repin(vm)) {
 		err = down_write_killable(&vm->lock);
 		write_locked = true;
@@ -285,13 +302,6 @@ retry:
 			goto err_exec;
 	}
 
-	job = xe_sched_job_create(q, xe_exec_queue_is_parallel(q) ?
-				  addresses : &args->address);
-	if (IS_ERR(job)) {
-		err = PTR_ERR(job);
-		goto err_exec;
-	}
-
 	/*
 	 * Wait behind rebinds and any kernel operations (evictions, defrag
 	 * moves, ...) on the VM and all external BOs. The VM's private BOs
@@ -359,16 +369,22 @@ err_repin:
 	if (!xe_vm_in_lr_mode(vm))
 		xe_svm_notifier_unlock(vm);
 err_put_job:
-	if (err)
-		xe_sched_job_put(job);
 err_exec:
 	if (!xe_vm_in_lr_mode(vm))
 		xe_validation_ctx_fini(&ctx);
 err_unlock_list:
 	up_read(&vm->lock);
-	if (err == -EAGAIN)
+	if (err == -EAGAIN) {
+		/* Start over with a fresh job: deps may have been added. */
+		if (job) {
+			xe_sched_job_put(job);
+			job = NULL;
+		}
 		goto retry;
+	}
 err_hw_exec_mode:
+	if (err && job)
+		xe_sched_job_put(job);
 	if (mode == EXEC_MODE_DMA_FENCE)
 		xe_hw_engine_group_put(group);
 err_syncs:

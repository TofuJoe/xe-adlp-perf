+	for (i = 0; xe->dpt_pool.entry && i < XE_DPT_POOL_SIZE; i++) {
+		struct xe_dpt_pool_entry *e = &xe->dpt_pool.entry[i];
+
+		if (!e->bo) {
+			e->bo = dpt;
+			e->src_gen = vma->dpt_src_gen;
+			e->pte = vma->dpt_pte;
+			e->view = vma->dpt_view;
 			dpt = NULL;
 			break;
 		}
@@ -269,6 +310,8 @@ static int __xe_pin_fb_vma_dpt(struct drm_gem_object *obj,
 	const struct i915_gtt_view *view = pin_params->view;
 	struct xe_bo *bo = gem_to_xe_bo(obj), *dpt;
 	u32 dpt_size, size = bo->ttm.base.size;
+	u64 src_gen, pte;
+	bool valid;
 
 	if (view->type == I915_GTT_VIEW_NORMAL)
 		dpt_size = ALIGN(size / XE_PAGE_SIZE * 8, XE_PAGE_SIZE);
@@ -280,11 +323,19 @@ static int __xe_pin_fb_vma_dpt(struct drm_gem_object *obj,
 		dpt_size = ALIGN(intel_rotation_info_size(&view->rotated) * 8,
 				 XE_PAGE_SIZE);
 
-	dpt = dpt_pool_get(xe, tile0->id, dpt_size, pin_params->alignment);
-	if (dpt) {
+	/*
+	 * The fb BO is pinned by the caller, so its backing generation can't
+	 * change while the DPT is being filled from it.
+	 */
+	src_gen = xe_bo_backing_gen(bo);
+	pte = xe_ggtt_encode_pte_flags(ggtt, bo, xe_cache_pat_idx(xe, XE_CACHE_NONE));
+
+	dpt = dpt_pool_get(xe, tile0, dpt_size, pin_params->alignment,
+			   src_gen, pte, view, &valid);
+	if (dpt && !valid) {
 		/* A fresh BO starts zeroed; padding entries are never written. */
 		iosys_map_memset(&dpt->vmap, 0, 0, dpt_size);
-	} else {
+	} else if (!dpt) {
 		dpt = xe_bo_create_pin_map_at_novm(xe, tile0,
 						   dpt_size,  ~0ull,
 						   ttm_bo_type_kernel,
@@ -297,8 +348,9 @@ static int __xe_pin_fb_vma_dpt(struct drm_gem_object *obj,
 			return PTR_ERR(dpt);
 	}
 
-	if (view->type == I915_GTT_VIEW_NORMAL) {
-		u64 pte = xe_ggtt_encode_pte_flags(ggtt, bo, xe_cache_pat_idx(xe, XE_CACHE_NONE));
+	if (valid) {
+		/* Same fb backing, flags and view as last written: nothing to do. */
+	} else if (view->type == I915_GTT_VIEW_NORMAL) {
 		u32 x;
 
 		for (x = 0; x < size / XE_PAGE_SIZE; x++) {
@@ -323,6 +375,9 @@ static int __xe_pin_fb_vma_dpt(struct drm_gem_object *obj,
 
 	vma->dpt = dpt;
 	vma->node = dpt->ggtt_node[tile0->id];
+	vma->dpt_src_gen = src_gen;
+	vma->dpt_pte = pte;
+	vma->dpt_view = *view;
 
 	/* Ensure DPT writes are flushed */
 	xe_device_l2_flush(xe);
@@ -510,7 +565,7 @@ static void __xe_unpin_fb_vma(struct i915_vma *vma)
 		return;
 
 	if (vma->dpt)
-		dpt_pool_put(xe_bo_device(vma->bo), vma->dpt);
+		dpt_pool_put(xe_bo_device(vma->bo), vma);
 	else if (vma->bo->ggtt_node[tile_id] != vma->node)
 		xe_ggtt_node_remove(vma->node, false);
 

 			xe_bo_unpin_map_no_vm(bo[i]);
 }
 
-static struct xe_bo *dpt_pool_get(struct xe_device *xe, u8 tile_id,
-				  size_t size, u32 alignment)
+/*
+ * Take a pooled DPT BO of @size whose GGTT node satisfies @alignment (checked
+ * the way the GGTT allocator applies it, relative to the GGTT start). Prefer
+ * one that already holds the entries for (@src_gen, @pte, @view); *@valid
+ * tells whether the returned BO can be used without rewriting it.
+ */
+static struct xe_bo *dpt_pool_get(struct xe_device *xe, struct xe_tile *tile,
+				  size_t size, u32 alignment, u64 src_gen,
+				  u64 pte, const struct i915_gtt_view *view,
+				  bool *valid)
 {
+	struct xe_ggtt *ggtt = tile->mem.ggtt;
 	struct xe_bo *bo = NULL;
-	int i;
+	int i, pick = -1;
+
+	*valid = false;
 
 	spin_lock(&xe->dpt_pool.lock);
 	for (i = 0; i < XE_DPT_POOL_SIZE; i++) {
-		struct xe_bo *cand = xe->dpt_pool.bo[i];
+		struct xe_dpt_pool_entry *e = &xe->dpt_pool.entry[i];
 
-		if (!cand || xe_bo_size(cand) != size)
+		if (!e->bo || xe_bo_size(e->bo) != size)
 			continue;
 		if (alignment &&
-		    !IS_ALIGNED(xe_ggtt_node_addr(cand->ggtt_node[tile_id]),
-				alignment))
+		    !IS_ALIGNED(xe_ggtt_node_addr(e->bo->ggtt_node[tile->id]) -
+				xe_ggtt_start(ggtt), alignment))
 			continue;
 
-		bo = cand;
-		xe->dpt_pool.bo[i] = NULL;
-		break;
+		if (e->src_gen == src_gen && e->pte == pte &&
+		    !memcmp(&e->view, view, sizeof(*view))) {
+			pick = i;
+			*valid = true;
+			break;
+		}
+		if (pick < 0)
+			pick = i;
+	}
+	if (pick >= 0) {
+		bo = xe->dpt_pool.entry[pick].bo;
+		xe->dpt_pool.entry[pick].bo = NULL;
 	}
 	spin_unlock(&xe->dpt_pool.lock);
 
 	return bo;
 }
 
-static void dpt_pool_put(struct xe_device *xe, struct xe_bo *dpt)
+static void dpt_pool_put(struct xe_device *xe, struct i915_vma *vma)
 {
+	struct xe_bo *dpt = vma->dpt;
 	int i;
 
 	spin_lock(&xe->dpt_pool.lock);
-	for (i = 0; i < XE_DPT_POOL_SIZE; i++) {

From 8bbbe7d5229432b42c874b3cfd487a331620be41 Mon Sep 17 00:00:00 2001
From: TofuJoe <darryl.hon@gmail.com>
Date: Mon, 14 Sep 2026 23:01:49 -0600
Subject: [PATCH 18/32] drm/xe/shrinker: Skip busy BOs and keep freed pages on
 error

The shrinker walk returned at the first BO that could not be shrunk, and
any error discarded the pages already freed. A purge pass therefore ended at
the first non-purgeable BO at the LRU head, and a busy VM aborted backup.

Continue past -EBUSY (bounded to 256 consecutive skips), and report the
pages already freed when a later error stops the walk.

Assisted-by: Claude:claude-opus-5
---
 drivers/gpu/drm/xe/xe_shrinker.c | 23 +++++++++++++++++++----
 1 file changed, 19 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/xe/xe_shrinker.c b/drivers/gpu/drm/xe/xe_shrinker.c
index 83374cd..b5b5ea4 100644
--- a/drivers/gpu/drm/xe/xe_shrinker.c
+++ b/drivers/gpu/drm/xe/xe_shrinker.c
@@ -54,12 +54,19 @@ xe_shrinker_mod_pages(struct xe_shrinker *shrinker, long shrinkable, long purgea
 	write_unlock(&shrinker->lock);
 }
 
+/*
+ * How many BOs in a row a walk may skip because they can't be shrunk right now
+ * (-EBUSY: not purgeable in a purge pass, not eviction-valuable, VM busy)
+ * before giving up. Bounds the walk cost when the LRU head is full of them.
+ */
+#define XE_SHRINK_MAX_BUSY_SKIPS 256
+
 static s64 __xe_shrinker_walk(struct xe_device *xe,
 			      struct ttm_operation_ctx *ctx,
 			      const struct xe_bo_shrink_flags flags,
 			      unsigned long to_scan, unsigned long *scanned)
 {
-	unsigned int mem_type;
+	unsigned int mem_type, busy = 0;
 	s64 freed = 0, lret;
 
 	for (mem_type = XE_PL_SYSTEM; mem_type <= XE_PL_TT; ++mem_type) {
@@ -79,9 +86,17 @@ static s64 __xe_shrinker_walk(struct xe_device *xe,
 				continue;
 
 			lret = xe_bo_shrink(ctx, ttm_bo, flags, scanned);
+			if (lret == -EBUSY) {
+				/* This BO can't be shrunk now; others may. */
+				if (++busy >= XE_SHRINK_MAX_BUSY_SKIPS)
+					return freed;
+				continue;
+			}
 			if (lret < 0)
-				return lret;
+				/* Don't discard pages already freed by this walk. */
+				return freed ?: lret;
 
+			busy = 0;
 			freed += lret;
 			if (*scanned >= to_scan)
 				break;
@@ -119,7 +134,7 @@ static s64 xe_shrinker_walk(struct xe_device *xe,
 	if (!ctx->no_wait_gpu) {
 		lret = __xe_shrinker_walk(xe, ctx, save_flags, to_scan, scanned);
 		if (lret < 0)
-			return lret;
+			return freed ?: lret;
 		freed += lret;
 		if (*scanned >= to_scan)
 			return freed;
@@ -128,7 +143,7 @@ static s64 xe_shrinker_walk(struct xe_device *xe,
 	if (flags.writeback) {
 		lret = __xe_shrinker_walk(xe, ctx, flags, to_scan, scanned);
 		if (lret < 0)
-			return lret;
+			return freed ?: lret;
 		freed += lret;
 	}
 

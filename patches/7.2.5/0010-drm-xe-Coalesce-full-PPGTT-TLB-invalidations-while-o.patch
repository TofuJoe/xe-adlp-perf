 drivers/gpu/drm/xe/xe_module.h          |   1 +
 drivers/gpu/drm/xe/xe_tlb_inval.c       | 203 ++++++++++++++++++++++--
 drivers/gpu/drm/xe/xe_tlb_inval_types.h |  18 +++
